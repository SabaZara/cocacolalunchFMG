# ============================================================
#  LUNCH meal-access  —  configuration
#  Copy this file to ".env" and fill in real values.
#  NEVER commit the real .env (it is gitignored).
# ============================================================

# IANA timezone used to decide the "calendar day" for the once-per-day rule.
# Default is Tbilisi. (tzdata is bundled so this works on Windows too.)
TIMEZONE=Asia/Tbilisi

# First admin account, seeded on first run.
# The app REFUSES TO START if the password is blank or "changeme".
# Use a strong, unique password.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Secret used to sign the login session cookie.
# Must be a long random string and STAY THE SAME across restarts
# (otherwise everyone is logged out / sessions can be forged).
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Shared secret that proves a request came through the remote tunnel/proxy.
# start.bat generates this automatically; you normally do NOT edit it by hand.
# If empty, the remote-admin gate falls back to "block everything but the kiosk".
TUNNEL_SECRET=

# Stable remote admin via ngrok.
# 1) Create a free ngrok account.
# 2) Copy your authtoken from https://dashboard.ngrok.com/get-started/your-authtoken
# 3) Copy your assigned free dev domain from Universal Gateway > Domains.
#    Put only the domain here, without https://, for example:
#    NGROK_DOMAIN=abc123.ngrok-free.app
NGROK_AUTHTOKEN=
NGROK_DOMAIN=

# Network binding. Keep HOST at 127.0.0.1 so the cafeteria LAN cannot reach
# the app directly — only the kiosk PC itself and the ngrok tunnel can.
HOST=127.0.0.1
PORT=8000

# SQLite database file (single-file, easy to back up).
DB_PATH=lunch.db

# Seed a few DEMO cards on first run (1001, 9999, ...). Keep this FALSE on a
# real kiosk so the card list contains only the cards you import. Set true only
# for a quick demo.
SEED_SAMPLE_CARDS=false

# The kiosk PC's clock runs AHEAD of real time by this many minutes; reports
# subtract it to show/bucket REAL times. Code default is 14 — set here only to
# override (remote updates preserve .env, so the default lives in code).
#KIOSK_CLOCK_AHEAD_MINUTES=14

# Meal windows for the quantitative report ("HH:MM", real local time; "24:00"
# allowed as an end). Code defaults: 00:00-18:00 and 18:00-24:00.
#MEAL1_START=00:00
#MEAL1_END=18:00
#MEAL2_START=18:00
#MEAL2_END=24:00
